# =========================================================
# superjoindata — Fact Knowledge Layer Configuration
# =========================================================

# Database Connection (Leave blank for local SQLite fallback, or provide free PostgreSQL URI)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# CORS allowed origins (Comma-separated URLs)
FRONTEND_URL=https://superjoindata.vercel.app,http://localhost:5173
CORS_ORIGINS=https://superjoindata.vercel.app,http://localhost:5173

# PDF Upload Constraints (Free-tier friendly)
MAX_PDF_SIZE_MB=20
MODEL_CACHE_DIR=/tmp/models

# Port for Web Service
PORT=8000

# =========================================================
# Frontend Environment Variables (.env.local in /frontend)
# =========================================================
# NEXT_PUBLIC_API_URL=https://superjoindata.onrender.com
# VITE_API_URL=https://superjoindata.onrender.com
